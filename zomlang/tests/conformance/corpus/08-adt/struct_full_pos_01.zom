const Vec3_COUNT: i32 = 0;
const Vec3_UNIT: Vec3<f32> = Vec3<f32> { x: 1.0, y: 0.0, z: 0.0, };

export struct Vec3<T: numeric> {
    public mut x: T;
    public mut y: T;
    readonly z: T;
    init(this, x: T, y: T, z: T) { this.x = x; this.y = y; this.z = z; }
    deinit(this) {}
    fun dot(this, other: Vec3<T>) -> T {
        return this.x * other.x + this.y * other.y + this.z * other.z;
    }
}
