// The closed set of diagnostics the binder may report. Each name must exist in
// compiler/diagnostics/defs/diagnostics-binder.def, which owns the numeric code;
// this file only selects which of those the binder is allowed to produce.

BINDER_ERROR(UndefinedIdentifier)
BINDER_ERROR(SymbolNamespaceMismatch)
BINDER_ERROR(RedeclareVariable)
BINDER_ERROR(RedeclareParameter)
BINDER_ERROR(RedeclareFunction)
BINDER_ERROR(RedeclareClass)
BINDER_ERROR(RedeclareInterface)
BINDER_ERROR(RedeclareEnum)
BINDER_ERROR(RedeclareTypeAlias)
BINDER_ERROR(DuplicateIdentifier)
BINDER_ERROR(BreakTargetNotFound)
BINDER_ERROR(ContinueTargetNotFound)
BINDER_ERROR(ContinueTargetNotLoop)
BINDER_ERROR(ContextualSelfOutsideType)

BINDER_NOTE(PreviousDeclarationHere)
