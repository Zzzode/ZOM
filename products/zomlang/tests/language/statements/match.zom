// RUN: %zomc compile --dump-ast %s | %FileCheck %s

match (x) {
  when _ => 0;
  when v: i32 => v;
  when (a: i32, b: str) if a > 0 => a;
  when { x: i32, y: str } => 1;
  when [a, b] => 2;
  when is i32 => 3;
  when x + 1 => 4;
  when Result.Ok(v: i32) => v;
  default => return 0;
}


// CHECK: {"root":4,"nodes":[{"id":1,"kind":130,"payload":[1,0,0]},{"id":2,"kind":228,"payload":[1,0,0]},{"id":3,"kind":233,"payload":[2,0,0]},{"id":4,"kind":368,"payload":[1,0,0]}]}
