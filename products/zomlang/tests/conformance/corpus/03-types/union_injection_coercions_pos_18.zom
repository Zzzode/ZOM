class Err {
    code: i32;
}

struct Holder {
    value: i32 | Err;
}

fun take(x: i32 | Err) -> unit {
    return;
}

fun produce(flag: bool) -> i32 | Err {
    if (flag) {
        return 1;
    }
    return Err { code: 1 };
}

let local: i32 | Err = 1;
take(2);
let from_call: i32 | Err = produce(true);
mut target: i32 | Err = Err { code: 2 };
target = 7;
let holder = Holder { value: 3 };
