// RUN: ! %zomc compile --dump-ast %corpus/16-attributes/hash_with_comment_reject_neg_13.zom 2>&1 | %FileCheck %s


// CHECK-LITERAL: Error [ZOM2057]: Stray '#' with no attribute following; expected '[' after '#' to start an attribute.
// CHECK:   --> products {{(?:.*[/\\])?hash_with_comment_reject_neg_13\.zom:1:1$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 1 | # // comment after hash
// CHECK-LITERAL:   | ^
// CHECK-LITERAL: Note [ZOM2058]: To start an attribute, write #[path::to::attribute].
// CHECK:   --> products {{(?:.*[/\\])?hash_with_comment_reject_neg_13\.zom:1:1$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 1 | # // comment after hash
// CHECK-LITERAL:   | ^
