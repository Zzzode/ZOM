// RUN: ! %zomc compile --dump-ast %corpus/02-lexical/numeric_sep_pos_neg_01.zom 2>&1 | %FileCheck %s


// CHECK-LITERAL: Error [ZOM2035]: Numeric separators are not allowed here
// CHECK:   --> products {{(?:.*[/\\])?numeric_sep_pos_neg_01\.zom:1:11$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 1 | let a = 0x_FF;
// CHECK-LITERAL:   |           ^
// CHECK-LITERAL: Error [ZOM2035]: Numeric separators are not allowed here
// CHECK:   --> products {{(?:.*[/\\])?numeric_sep_pos_neg_01\.zom:2:13$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 2 | let b = 0xFF_;
// CHECK-LITERAL:   |             ^
// CHECK-LITERAL: Error [ZOM2035]: Numeric separators are not allowed here
// CHECK:   --> products {{(?:.*[/\\])?numeric_sep_pos_neg_01\.zom:3:11$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 3 | let c = 0b__01;
// CHECK-LITERAL:   |           ^
// CHECK-LITERAL: Error [ZOM2035]: Numeric separators are not allowed here
// CHECK:   --> products {{(?:.*[/\\])?numeric_sep_pos_neg_01\.zom:3:12$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 3 | let c = 0b__01;
// CHECK-LITERAL:   |            ^
// CHECK-LITERAL: Error [ZOM2035]: Numeric separators are not allowed here
// CHECK:   --> products {{(?:.*[/\\])?numeric_sep_pos_neg_01\.zom:4:13$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 4 | let d = 0o77_;
// CHECK-LITERAL:   |             ^
// CHECK-LITERAL: Error [ZOM2036]: Multiple consecutive numeric separators are not permitted
// CHECK:   --> products {{(?:.*[/\\])?numeric_sep_pos_neg_01\.zom:5:11$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 5 | let e = 1__23;
// CHECK-LITERAL:   |           ^
