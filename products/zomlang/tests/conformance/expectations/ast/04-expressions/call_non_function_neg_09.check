// RUN: %zomc compile --dump-ast %corpus/04-expressions/call_non_function_neg_09.zom | %FileCheck %s

// CHECK: SourceFile
// CHECK:         LetStmt
// CHECK-SAME:    kind=Let
// CHECK:                     IdentifierPattern
// CHECK-SAME:                  name="f"
// CHECK:                     PredefinedTypeExpr
// CHECK-SAME:                  kind=I32
// CHECK:         ExpressionStatement
// CHECK-NEXT:           expression:
// CHECK-NEXT:             CallExpression
// CHECK-NEXT:               callee:
// CHECK-NEXT:                 IdentExpr
// CHECK-SAME:                  name="f"
// CHECK-NEXT:               type_args: []
// CHECK-NEXT:               args: []
