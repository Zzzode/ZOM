// RUN: ! %zomc compile --dump-ast %corpus/06-declarations/receiver_forbidden_contexts_neg_06.zom 2>&1 | %FileCheck %s


// CHECK-LITERAL: Error [ZOM2095]: Receiver 'this' is not allowed in module function
// CHECK-LITERAL:   --> conformance/receiver_forbidden_contexts_neg_06.zom:1:20
// CHECK-LITERAL:   |
// CHECK-LITERAL: 1 | fun moduleReceiver(this) {}
// CHECK-LITERAL:   |                    ^
// CHECK-LITERAL: Error [ZOM2095]: Receiver 'this' is not allowed in block function
// CHECK-LITERAL:   --> conformance/receiver_forbidden_contexts_neg_06.zom:4:23
// CHECK-LITERAL:   |
// CHECK-LITERAL: 4 |     fun blockReceiver(this) {}
// CHECK-LITERAL:   |                       ^
// CHECK-LITERAL: Error [ZOM2095]: Receiver 'this' is not allowed in extern function
// CHECK-LITERAL:   --> conformance/receiver_forbidden_contexts_neg_06.zom:8:24
// CHECK-LITERAL:   |
// CHECK-LITERAL: 8 |     fun externReceiver(this);
// CHECK-LITERAL:   |                        ^
// CHECK-LITERAL: Error [ZOM2095]: Receiver 'this' is not allowed in function expression
// CHECK-LITERAL:   --> conformance/receiver_forbidden_contexts_neg_06.zom:11:28
// CHECK-LITERAL:    |
// CHECK-LITERAL: 11 | let functionReceiver = fun(this) {};
// CHECK-LITERAL:    |                            ^
// CHECK-LITERAL: Error [ZOM2095]: Receiver 'this' is not allowed in lambda
// CHECK-LITERAL:   --> conformance/receiver_forbidden_contexts_neg_06.zom:12:23
// CHECK-LITERAL:    |
// CHECK-LITERAL: 12 | let lambdaReceiver = (this) => this;
// CHECK-LITERAL:    |                       ^
