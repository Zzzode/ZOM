// RUN: ! %zomc compile --dump-ast %corpus/09-interfaces/errors/interface-method-missing-parens.zom 2>&1 | %FileCheck %s


// CHECK-LITERAL: Error [ZOM2092]: Interface bodies accept only methods, accessors, and associated type declarations
// CHECK:   --> products {{(?:.*[/\\])?interface\-method\-missing\-parens\.zom:3:3$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 3 |   let i -> i32;
// CHECK-LITERAL:   |   ^
// CHECK-LITERAL: Error [ZOM2092]: Interface bodies accept only methods, accessors, and associated type declarations
// CHECK:   --> products {{(?:.*[/\\])?interface\-method\-missing\-parens\.zom:4:3$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 4 |   const f: str;
// CHECK-LITERAL:   |   ^
// CHECK-LITERAL: Error [ZOM2025]: Expected '('
// CHECK:   --> products {{(?:.*[/\\])?interface\-method\-missing\-parens\.zom:2:11$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 2 |   fun foo -> i32;
// CHECK-LITERAL:   |           ^
// CHECK-LITERAL: Error [ZOM2025]: Expected ':'
// CHECK:   --> products {{(?:.*[/\\])?interface\-method\-missing\-parens\.zom:3:9$}}
// CHECK-LITERAL:   |
// CHECK-LITERAL: 3 |   let i -> i32;
// CHECK-LITERAL:   |         ^
