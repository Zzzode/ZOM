// RUN: %zomc compile --dump-ast %corpus/05-statements/immutable_assignment_neg_02.zom | %FileCheck %s

// CHECK: SourceFile
// CHECK:         LetStmt
// CHECK-SAME:    kind=Let
// CHECK:                     IdentifierPattern
// CHECK-SAME:                  name="x"
// CHECK:                     PredefinedTypeExpr
// CHECK-SAME:                  kind=I32
// CHECK:         ExpressionStatement
// CHECK-NEXT:           expression:
// CHECK-NEXT:             AssignmentExpr
// CHECK-SAME:               op=Assign
// CHECK-NEXT:               lhs:
// CHECK-NEXT:                 IdentExpr
// CHECK-SAME:                  name="x"
// CHECK-NEXT:               rhs:
// CHECK-NEXT:                 IntLiteral
