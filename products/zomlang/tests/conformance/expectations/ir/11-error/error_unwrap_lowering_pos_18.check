// RUN: %zomc compile --emit ir %corpus/11-error/error_unwrap_lowering_pos_18.zom | %FileCheck %s

// CHECK: function @answer signature=fn() -> i32 raises bool abi_return=union(bool | i32) layout=1
// CHECK-NEXT:   ^bb1:
// CHECK-NEXT:     %{{[0-9]+}} = call.raising @fetch type=union(i32 | str)
// CHECK-NEXT:     error_union.branch %{{[0-9]+}} layout=0 success=^bb2 error=^bb3
// CHECK-NEXT:   ^bb2:
// CHECK-NEXT:     %{{[0-9]+}} = error_union.move_payload %{{[0-9]+}} layout=0 tag=0 type=i32
// CHECK-NEXT:     %{{[0-9]+}} = error_union.construct %{{[0-9]+}} layout=1 tag=0 type=union(bool | i32)
// CHECK-NEXT:     jump ^bb4(%{{[0-9]+}})
// CHECK-NEXT:   ^bb3:
// CHECK-NEXT:     panic.forced_unwrap %{{[0-9]+}} layout=0 tag=1 payload_type=str file="{{.*}}error_unwrap_lowering_pos_18.zom" line=6 column=19 byte_start=102 byte_end=104
// CHECK-NEXT:   ^bb4(%{{[0-9]+}}:union(bool | i32)):
// CHECK-NEXT:     return %{{[0-9]+}} type=union(bool | i32)
