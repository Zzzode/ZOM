// RUN: %zomc compile --emit ir %corpus/11-error/error_union_construct_pos_15.zom | %FileCheck %s
// RUN: not %zomc compile --emit ir -o /dev/null/out.ir %corpus/11-error/error_union_construct_pos_15.zom 2>&1 | %FileCheck %s --check-prefix=OUTPUT

// OUTPUT: Error [ZOM6008]: IR emission could not create its output stream
// OUTPUT-NOT: Uncaught exception
// OUTPUT-NOT: Stack trace
// OUTPUT-NOT: Compilation failed due to emission errors

// CHECK: zom.ir.v0
// CHECK-NEXT: target pointer_size=8 pointer_align=8
// CHECK-NEXT: layout 0 type=union(i32 | str) kind=tagged_union tag=u8 tag_offset=0 payload_state=known payload_offset=8 payload_size=16 payload_align=8 size=24 align=8
// CHECK-NEXT:   alternative tag=0 kind=success type=i32 payload_state=known payload_size=4 payload_align=4
// CHECK-NEXT:   alternative tag=1 kind=error type=str payload_state=known payload_size=16 payload_align=8
// CHECK-NEXT: function @answer signature=fn() -> i32 raises str abi_return=union(i32 | str) layout=0
// CHECK-NEXT:   ^bb1:
// CHECK-NEXT:     %{{[0-9]+}} = integer.constant 42 type=i32
// CHECK-NEXT:     %{{[0-9]+}} = error_union.construct %{{[0-9]+}} layout=0 tag=0 type=union(i32 | str)
// CHECK-NEXT:     return %{{[0-9]+}} type=union(i32 | str)
