// §20.2 Non-"C" ABI string: "system" (platform-default calling convention)
// Covers rule: checkExternAbiFormat (permitted set member "system")
// Expected: ACCEPT
// ExpectedDiagnostic: none
extern "system" {
    fun malloc(sz: usize) -> u64;
    fun calloc(n: usize, sz: usize) -> u64;
    fun realloc(p: u64, sz: usize) -> u64;
    fun c_free(p: u64);
}
