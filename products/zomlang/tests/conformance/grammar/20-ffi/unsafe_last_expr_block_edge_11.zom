// §20.1 Unsafe block whose value is its final expression (tail expr, no semicolon)
// Covers rule: unsafeBlockExpr (trailing expression alt — statement* expression)
// Expected: ACCEPT
// ExpectedDiagnostic: none
fun compute() -> i32 {
    let v = unsafe {
        prepare_resources();
        compute_value()
    };
    return v;
}
