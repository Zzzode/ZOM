// §20.1 Unsafe block expression wrapping a dangerous FFI call
// Covers rule: unsafeBlockExpr, primaryExpr (exprUnsafeBlock alt)
// Expected: ACCEPT
// ExpectedDiagnostic: none
fun demo() -> i32 {
    let result = unsafe {
        ffi_dangerous_op();
        touch_raw_memory();
        0
    };
    return result;
}
