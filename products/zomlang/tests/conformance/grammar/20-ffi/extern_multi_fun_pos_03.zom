// §20.2 extern block with multiple foreign function declarations inside
// Covers rule: externBlock (externItem* closure, 3+ items)
// Expected: ACCEPT
// ExpectedDiagnostic: none
extern "zom-cdecl" {
    fun open(path: str, flags: i32) -> i32;
    fun read(fd: i32, buf: str, len: u64) -> i64;
    fun write(fd: i32, buf: str, len: u64) -> i64;
    fun close(fd: i32) -> i32;
}
