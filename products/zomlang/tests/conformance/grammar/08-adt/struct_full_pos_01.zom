// §8.1 StructDeclaration
// Covers rule: structDeclaration
// Expected: ACCEPT

// NOTE: struct bodies do not accept static or const value members. Keep these
// constants at module scope.
const Vec3_COUNT: i32 = 0;
const Vec3_UNIT: Vec3<f32> = Vec3<f32> { x: 1.0, y: 0.0, z: 0.0, };

public struct Vec3<T: numeric> {
    public mut x: T;
    public mut y: T;
    readonly z: T;
    init(x: T, y: T, z: T) { self.x = x; self.y = y; self.z = z; }
    deinit() {}
    fun dot(other: Vec3<T>) -> T { return self.x * other.x + self.y * other.y + self.z * other.z; }
}
