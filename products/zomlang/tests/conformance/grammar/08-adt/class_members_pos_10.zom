// §8.2 ClassMembers
// Covers rule: classMember (all alternatives)
// Expected: ACCEPT

class Counter {
    private mut _value: i32 = 0;
    static let instances: i32 = 0;
    const MAX: i32 = 1000;
    init(initial: i32) { self._value = initial; }
    fun inc() -> unit { self._value = self._value + 1; }
    fun getValue() -> i32 { return self._value; }
}
