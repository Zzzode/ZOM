// §8.2 ClassDeclaration
// Covers rule: classDeclaration + standaloneImplDeclaration
// Expected: ACCEPT

interface Drawable { fun draw() -> unit; }
interface Updatable { fun update(dt: f32) -> unit; }
public class Sprite extends Object {
    protected mut x: f32 = 0.0;
    let name: str;
    init(name: str, x: f32) { self.name = name; self.x = x; }
    override fun draw() -> unit { }
    fun update(dt: f32) -> unit { self.x = self.x + dt; }
}
impl Drawable + Updatable for Sprite { }
