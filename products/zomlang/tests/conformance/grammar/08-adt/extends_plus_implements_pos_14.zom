// §8.2 Extends + Impl (heritage + standalone impl)
// Covers rule: classDeclaration (EXTENDS) + standaloneImplDeclaration
// Expected: ACCEPT

interface Flyable { fun fly() -> unit; }
interface Swimmable { fun swim() -> unit; }
class Animal { fun breathe() -> unit { } }
class Duck extends Animal {
    override fun fly() -> unit { }
    fun swim() -> unit { }
}
impl Flyable + Swimmable for Duck { }
