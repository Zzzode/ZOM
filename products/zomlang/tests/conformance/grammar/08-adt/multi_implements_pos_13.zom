// §8.2 MultiInterface Impl
// Covers rule: standaloneImplDeclaration (multi-bound PLUS conjunction)
// Expected: ACCEPT

interface A { fun a() -> unit; }
interface B { fun b() -> unit; }
interface C { fun c() -> unit; }
struct S {
    fun a() -> unit { }
    fun b() -> unit { }
    fun c() -> unit { }
}
impl A + B + C for S { }
