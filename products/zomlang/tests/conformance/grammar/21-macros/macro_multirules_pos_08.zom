// §21.3 Multi-rule declarative macro 2.0: two patterns separated by `;`
// Covers rule: macroRulesDecl (two macroRule iterations, SEMI present / optional)
// Expected: ACCEPT
// ExpectedDiagnostic: none
macro choose! {
    ( $a:expr ) => {
        $a
    };
    ( $a:expr, $b:expr ) => {
        if cond() { $a } else { $b }
    }
}
