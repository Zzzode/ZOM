{
  "version": 1,
  "producers": {
    "ModuleDeclaration": {"identities": ["Module", "ModuleAlias"], "parser": "declaration-parser.cc"},
    "ExternDecl": {"identities": ["Function"], "parser": "declaration-parser.cc"},
    "ExternVarDecl": {"identities": ["Static"], "parser": "declaration-parser.cc"},
    "UnitVariant": {"identities": ["EnumVariant"], "parser": "declaration-parser.cc"},
    "TupleVariant": {"identities": ["EnumVariant"], "parser": "declaration-parser.cc"},
    "EnumDeclaration": {"identities": ["Enum"], "parser": "declaration-parser.cc"},
    "FunctionDecl": {"identities": ["Function"], "parser": "declaration-parser.cc"},
    "ClassDecl": {"identities": ["Class"], "parser": "declaration-parser.cc"},
    "StructDecl": {"identities": ["Struct"], "parser": "declaration-parser.cc"},
    "FunctionParameterDecl": {"identities": ["Parameter"], "parser": "declaration-parser.cc"},
    "InterfaceDecl": {"identities": ["Interface"], "parser": "declaration-parser.cc"},
    "ErrorDecl": {"identities": ["Error"], "parser": "declaration-parser.cc"},
    "AliasDecl": {"identities": ["TypeAlias"], "parser": "declaration-parser.cc"},
    "MethodDecl": {"identities": ["Method"], "parser": "declaration-parser.cc"},
    "FieldDecl": {"identities": ["Field"], "parser": "declaration-parser.cc"},
    "AssociatedTypeDecl": {"identities": ["AssociatedType"], "parser": "declaration-parser.cc"},
    "GenericTypeParam": {"identities": ["TypeParameter"], "parser": "type-parser.cc"},
    "ConstructorDecl": {"identities": ["Constructor"], "parser": "declaration-parser.cc"},
    "DestructorDecl": {"identities": ["Destructor"], "parser": "declaration-parser.cc"},
    "ClassConstDecl": {"identities": ["Constant"], "parser": "declaration-parser.cc"},
    "StandaloneImplDecl": {"identities": ["Impl"], "parser": "declaration-parser.cc"},
    "MarkerImpl": {"identities": ["Impl"], "parser": "declaration-parser.cc"},
    "LetStmt": {"identities": ["Constant", "Static", "Local"], "parser": "statement-parser.cc"},
    "ForInStatement": {"identities": ["PatternBinding"], "parser": "statement-parser.cc"},
    "MatchArmStmt": {"identities": ["PatternBinding"], "parser": "statement-parser.cc"},
    "RestPattern": {"identities": ["PatternBinding", "Constant", "Static", "Local"], "parser": "pattern-parser.cc"},
    "BindingPattern": {"identities": ["PatternBinding", "Constant", "Static", "Local"], "parser": "pattern-parser.cc"},
    "IdentifierPattern": {"identities": ["PatternBinding", "Constant", "Static", "Local"], "parser": "pattern-parser.cc"},
    "PatternProperty": {"identities": ["PatternBinding", "Constant", "Static", "Local"], "parser": "pattern-parser.cc"},
    "FunctionExpression": {"identities": ["Closure"], "anonymous_role": "FunctionExpression", "parser": "expression-parser.cc"},
    "LambdaExpression": {"identities": ["Closure"], "anonymous_role": "Lambda", "parser": "expression-parser.cc"},
    "ImportDeclaration": {"identities": ["ImportAlias"], "parser": "declaration-parser.cc"},
    "ImportSpecifier": {"identities": ["ImportAlias"], "parser": "declaration-parser.cc"},
    "ExportDeclaration": {"identities": ["ReexportAlias"], "parser": "declaration-parser.cc"},
    "ExportSpecifier": {"identities": ["ReexportAlias"], "parser": "declaration-parser.cc"}
  },
  "no_identity": {
    "SourceFile": "compilation-unit container",
    "ExternBlock": "FFI declaration container",
    "EnumVariantList": "enum variant container",
    "VariableDeclarator": "binding-leaf container",
    "VariableDeclaratorList": "declarator container",
    "GenericParams": "type-parameter container",
    "FunctionParameterList": "parameter container",
    "ImplIfaceList": "implemented-interface container",
    "ClassMemberList": "member container",
    "StatementListItem": "attribute-bearing statement container",
    "AttributeList": "attribute container",
    "Attribute": "semantic metadata rather than a definition"
  },
  "expansion_producers": [],
  "legacy_symbol_id_allowlist": [
    "products/zomlang/compiler/ast/tree.cc",
    "products/zomlang/compiler/ast/tree.h",
    "products/zomlang/compiler/binder/name-resolver.cc",
    "products/zomlang/compiler/checker/body-checker.cc",
    "products/zomlang/compiler/irgen/ir-dump.cc",
    "products/zomlang/compiler/irgen/ir-dump.h",
    "products/zomlang/compiler/irgen/ir.cc",
    "products/zomlang/compiler/irgen/ir.h",
    "products/zomlang/compiler/irgen/lowering.cc",
    "products/zomlang/compiler/symbol/namespace-symbol.h",
    "products/zomlang/compiler/symbol/package-symbol.h",
    "products/zomlang/compiler/symbol/symbol-id.h",
    "products/zomlang/compiler/symbol/symbol-table.cc",
    "products/zomlang/compiler/symbol/symbol.cc",
    "products/zomlang/compiler/symbol/symbol.h",
    "products/zomlang/compiler/symbol/type-symbol.cc",
    "products/zomlang/compiler/symbol/type-symbol.h",
    "products/zomlang/compiler/symbol/value-symbol.cc",
    "products/zomlang/compiler/symbol/value-symbol.h",
    "products/zomlang/compiler/type/type-env.h"
  ],
  "pointer_identity_allowlist": [
    "products/zomlang/compiler/binder/decl-collector.cc",
    "products/zomlang/compiler/binder/name-resolver.cc",
    "products/zomlang/compiler/checker/body-checker.cc"
  ]
}
