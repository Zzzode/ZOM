//
// Intentionally no include guard. Define ZOM_BINDING_FACT before including.
//
// Columns:
//   id, record type, candidate member, accessor, publication, stable tag,
//   domain, required mutation classes, executable mutation test.

ZOM_BINDING_FACT(SourceFailure, BindingFailureRef, sourceFailures, sourceFailures, Internal, 0x01,
                 Diagnostics, "missing|additional|reordered|field",
                 "BindingVerifier.RejectsMalformedLabelDuplicateFailuresAndDeclarationBindings")
ZOM_BINDING_FACT(NodeScope, NodeScopeFact, nodeScopes, nodeScopes, Published, 0x02, Scope,
                 "missing|additional|duplicate|reordered|identity|relation",
                 "BindingVerifier.RejectsMissingAndMalformedFunctionScopes")
