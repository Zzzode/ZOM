// ============================================================================
// Basic semantic errors
// ============================================================================

DIAG(9001, TypeMismatch, kError, "Type mismatch: expected {0}, got {1}", 2)
DIAG(9002, DuplicateIdentifier, kError, "Duplicate identifier: '{0}'", 1)
DIAG(9003, RedeclareVariable, kError, "Cannot redeclare variable '{0}'", 1)
DIAG(9004, RedeclareParameter, kError, "Cannot redeclare parameter '{0}'", 1)
DIAG(9005, RedeclareFunction, kError, "Cannot redeclare function '{0}'", 1)
DIAG(9006, RedeclareClass, kError, "Cannot redeclare class '{0}'", 1)
DIAG(9007, RedeclareInterface, kError, "Cannot redeclare interface '{0}'", 1)
DIAG(9008, RedeclareEnum, kError, "Cannot redeclare enum '{0}'", 1)
DIAG(9009, RedeclareTypeAlias, kError, "Cannot redeclare type alias '{0}'", 1)
DIAG(9010, RedeclaraBlockScopedVariable, kError, "Cannot redeclare block-scoped variable '{0}'", 1)
DIAG(9011, EnumMergeConflict, kError,
     "Enum declarations can only merge with namespace or other enum declarations", 0)
DIAG(9012, MultipleDefaultExports, kError, "A module cannot have multiple default exports", 0)

// Contextual identifier validation errors
DIAG(9013, ReservedWord, kError, "Identifier expected. '{0}' is a reserved word", 1)
DIAG(9014, ReservedInContext, kError,
     "Identifier expected. '{0}' is a reserved word that cannot be used here", 1)
DIAG(9015, ReservedInModule, kError,
     "Identifier expected. '{0}' is a reserved word at the top level of a module", 1)

DIAG(9016, SemanticError, kError, "{0}", 1)

// ============================================================================
// Type mismatch diagnostics
// ============================================================================

DIAG(9017, ReturnTypeMismatch, kError, "Return type mismatch: expected {0}, got {1}", 2)
DIAG(9018, ArgumentTypeMismatch, kError,
     "Argument type mismatch in call to '{0}': expected {1}, got {2}", 3)
DIAG(9019, AssignmentTypeMismatch, kError,
     "Cannot assign value of type '{0}' to variable of type '{1}'", 2)
DIAG(9020, InitializerTypeMismatch, kError,
     "Initializer type '{0}' does not match declared type '{1}'", 2)
DIAG(9021, ConditionNotBool, kError, "Condition must be of type 'bool', got '{0}'", 1)
DIAG(9022, OperandTypeMismatch, kError,
     "Operator '{0}' cannot be applied to types '{1}' and '{2}'", 3)
DIAG(9023, UnaryOperandTypeMismatch, kError,
     "Unary operator '{0}' cannot be applied to type '{1}'", 2)
DIAG(9024, InvalidCast, kError, "Cannot cast from type '{0}' to type '{1}'", 2)
DIAG(9025, NotCallable, kError, "Type '{0}' is not callable", 1)
DIAG(9026, NotIndexable, kError, "Type '{0}' is not indexable", 1)
DIAG(9027, ArrayIndexNotInt, kError, "Array index must be of integer type, got '{0}'", 1)
DIAG(9028, InvalidNewTarget, kError, "Cannot use 'new' on type '{0}': not a class type", 1)

// ============================================================================
// Undefined symbol diagnostics
// ============================================================================

DIAG(9029, UndefinedType, kError, "Undefined type: '{0}'", 1)
DIAG(9030, UndefinedMember, kError, "Type '{0}' has no member named '{1}'", 2)
DIAG(9031, UndefinedMethod, kError, "Type '{0}' has no method named '{1}'", 2)
DIAG(9032, UndefinedEnumVariant, kError, "Enum '{0}' has no variant named '{1}'", 2)
DIAG(9033, UndefinedInterface, kError, "Undefined interface: '{0}'", 1)
DIAG(9034, NotAType, kError, "'{0}' does not refer to a type", 1)
DIAG(9035, NotAValue, kError, "'{0}' does not refer to a value", 1)
DIAG(9036, AmbiguousReference, kError, "Ambiguous reference to '{0}'", 1)
DIAG(9037, UseBeforeDecl, kError, "Use of '{0}' before its declaration", 1)

// ============================================================================
// Exhaustiveness diagnostics
// ============================================================================

DIAG(9038, NonExhaustiveMatch, kError,
     "Match expression is not exhaustive. Missing patterns: {0}", 1)
DIAG(9039, UnreachableMatchArm, kWarning, "Match arm is unreachable", 0)
DIAG(9040, IrrefutablePattern, kWarning,
     "Pattern always matches; subsequent arms are unreachable", 0)

// ============================================================================
// Trait and interface diagnostics
// ============================================================================

DIAG(9041, TraitNotImplemented, kError,
     "Type '{0}' does not implement trait '{1}'", 2)
DIAG(9042, OrphanImpl, kError,
     "Orphan impl: cannot implement trait '{0}' for type '{1}' (neither is local)", 2)
DIAG(9043, DuplicateImpl, kError,
     "Duplicate implementation of trait '{0}' for type '{1}'", 2)
DIAG(9044, ImplMissingMethod, kError,
     "Impl of trait '{0}' for type '{1}' is missing required method '{2}'", 3)
DIAG(9045, ImplMethodSignatureMismatch, kError,
     "Method '{0}' in impl of trait '{1}' has wrong signature: expected {2}, got {3}", 4)
DIAG(9046, ImplExtraMethod, kWarning,
     "Method '{0}' is not a member of trait '{1}'", 2)
DIAG(9047, MarkerImplNonLocal, kError,
     "Marker impl of '{0}' must be in the same module as the type or trait", 1)
DIAG(9048, SealedImplOutside, kError,
     "Cannot implement sealed trait '{0}' outside its defining module", 1)
DIAG(9049, AmbiguousAssociatedType, kError,
     "Ambiguous associated type '{0}' for type '{1}'; use '<{1} as Interface>::{0}'", 2)

// ============================================================================
// Subtype diagnostics
// ============================================================================

DIAG(9050, NotSubtype, kError, "Type '{0}' is not a subtype of '{1}'", 2)
DIAG(9051, WidthSubtypeViolation, kError,
     "Object type '{0}' is missing required field '{1}' of type '{2}'", 3)
DIAG(9052, DepthSubtypeViolation, kError,
     "Field '{0}' has type '{1}' which is not a subtype of expected '{2}'", 3)
DIAG(9053, VarianceMismatch, kError,
     "Type parameter variance mismatch: expected {0}, got {1}", 2)
DIAG(9054, MutableReferenceSubtype, kError,
     "Cannot convert mutable reference to immutable reference of a different type", 0)
DIAG(9055, ReferenceLifetimeMismatch, kError, "Reference lifetime mismatch", 0)

// ============================================================================
// Function and call diagnostics
// ============================================================================

DIAG(9056, TooManyArguments, kError,
     "Too many arguments: expected {0}, got {1}", 2)
DIAG(9057, TooFewArguments, kError,
     "Too few arguments: expected {0}, got {1}", 2)
DIAG(9058, ArgumentCountMismatch, kError,
     "Function '{0}' expects {1} arguments, but {2} were provided", 3)
DIAG(9059, NoMatchingOverload, kError, "No matching overload for call to '{0}'", 1)
DIAG(9060, ReturnFromVoid, kError,
     "Returning value from function with 'void' return type", 0)
DIAG(9061, MissingReturn, kError,
     "Function '{0}' declared to return '{1}' but no return statement found", 2)
DIAG(9062, NamedArgNotFound, kError, "No parameter named '{0}' found in function '{1}'", 2)
DIAG(9063, DuplicateNamedArg, kError, "Duplicate named argument: '{0}'", 1)

// ============================================================================
// Class and inheritance diagnostics
// ============================================================================

DIAG(9064, OverrideMismatch, kError,
     "Method '{0}' overrides base method with incompatible signature: expected {1}, got {2}", 3)
DIAG(9065, OverrideNonVirtual, kError,
     "Method '{0}' marked 'override' but base class has no virtual method with that name", 1)
DIAG(9066, FinalOverride, kError,
     "Cannot override final method '{0}' from base class", 1)
DIAG(9067, SealedExtend, kError, "Cannot extend sealed class '{0}' outside its module", 1)
DIAG(9068, AbstractInstantiation, kError,
     "Cannot instantiate abstract class '{0}': missing implementations for {1}", 2)
DIAG(9069, FieldAccessDenied, kError, "Cannot access private field '{0}'", 1)
DIAG(9070, MethodAccessDenied, kError, "Cannot access private method '{0}'", 1)
DIAG(9071, ThisOutsideClass, kError, "'this' used outside of class method", 0)
DIAG(9072, SuperOutsideClass, kError, "'super' used outside of class method", 0)
DIAG(9073, SuperNoBase, kError, "'super' used but class has no base class", 0)

// ============================================================================
// Generic and type parameter diagnostics
// ============================================================================

DIAG(9074, TypeArgCountMismatch, kError,
     "Type '{0}' expects {1} type arguments, but {2} were provided", 3)
DIAG(9075, TypeParamBoundViolation, kError,
     "Type argument '{0}' does not satisfy bound '{1}'", 2)
DIAG(9076, InconsistentTypeVar, kError,
     "Inconsistent type variable usage: '{0}' inferred to both '{1}' and '{2}'", 3)
DIAG(9077, OccursCheck, kError, "Infinite type detected: '{0}' occurs in '{1}'", 2)
DIAG(9078, UnresolvedTypeVar, kWarning, "Could not infer type for '{0}'; using 'any'", 1)

// ============================================================================
// Miscellaneous diagnostics
// ============================================================================

DIAG(9079, UnusedVariable, kWarning, "Unused variable: '{0}'", 1)
DIAG(9080, UnusedImport, kWarning, "Unused import: '{0}'", 1)
DIAG(9081, ShadowedVariable, kRemark, "Variable '{0}' shadows an outer declaration", 1)
DIAG(9082, ImplicitAny, kWarning, "Parameter '{0}' implicitly has 'any' type", 1)
DIAG(9083, DiscardedValue, kWarning, "Value of type '{0}' is discarded", 1)
DIAG(9084, IntegerOverflow, kWarning, "Integer literal overflows type '{0}'", 1)
DIAG(9085, DivideByZero, kWarning, "Potential division by zero", 0)
