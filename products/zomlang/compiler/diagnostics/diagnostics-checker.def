// RFC 0005 type checker diagnostics. Numeric values are explicit because
// the language specification assigns stable semantic codes, not file-order IDs.

CHECKER_DIAG(331, DynGenericMethod, kError,
             "Interface '{0}' has generic method '{1}' and cannot be used as dyn", 2)
CHECKER_DIAG(332, DynSelfReturn, kError,
             "Interface '{0}' has method '{1}' returning Self and cannot be used as dyn", 2)
CHECKER_DIAG(333, DynMoveSelf, kError,
             "Interface '{0}' has method '{1}' with move self receiver and cannot be used as dyn",
             2)
CHECKER_DIAG(334, DynUnassociatedType, kError,
             "dyn interface '{0}' requires associated type '{1}' to be bound", 2)
CHECKER_DIAG(335, DynStaticMethod, kError,
             "Interface '{0}' has a static method and cannot be used as dyn", 1)
CHECKER_DIAG(336, DynGatNotAllowed, kError,
             "Interface '{0}' has generic associated type '{1}' and cannot be used as dyn", 2)
CHECKER_DIAG(337, DynUnsizedParameter, kError,
             "Interface '{0}' has method '{1}' with unsized type '{2}' and cannot be used as dyn",
             3)
CHECKER_DIAG(338, DynSuperNotObjectSafe, kError,
             "Interface '{0}' inherits object-unsafe interface '{1}' and cannot be used as dyn", 2)
CHECKER_DIAG(410, TypeCheckerTypeMismatch, kError, "Type mismatch: expected {0}, got {1}", 2)
CHECKER_DIAG(411, CannotUnifyTypes, kError, "Cannot unify '{0}' with '{1}' in {2}", 3)
CHECKER_DIAG(412, InfiniteType, kError, "Infinite type: {0}", 1)
CHECKER_DIAG(420, CannotInferTypeParameter, kError,
             "Cannot infer type parameter '{0}'; provide explicit type arguments", 1)
CHECKER_DIAG(421, CannotInferNullInitializer, kError,
             "Cannot infer type from null initializer without annotation", 0)
CHECKER_DIAG(430, ConflictingImpl, kError, "Conflicting implementations of '{0}' for type '{1}'", 2)
CHECKER_DIAG(431, CheckerTraitNotImplemented, kError, "'{0}' does not implement '{1}'", 2)
CHECKER_DIAG(432, OperatorTraitSignatureMismatch, kError,
             "Operator trait '{0}' for type '{1}' must define '{2}({3}) -> {4}'", 5)
CHECKER_DIAG(433, NoAssociatedTypeProjection, kError, "No associated type '{0}' for type '{1}'", 2)
CHECKER_DIAG(434, AmbiguousAssociatedTypeProjection, kError,
             "Ambiguous associated type '{0}' for type '{1}'; use '<{1} as Interface>::{0}'", 2)
CHECKER_DIAG(440, CheckerNonExhaustiveMatch, kError, "Non-exhaustive match. Missing patterns: {0}",
             1)
CHECKER_DIAG(442, CheckerUnreachableMatchArm, kWarning,
             "Unreachable match arm: pattern never matches", 0)
CHECKER_DIAG(450, CannotMutateImmutableVariable, kError, "Cannot mutate immutable variable '{0}'",
             1)
CHECKER_DIAG(460, ErrorPropagateOutsideRaises, kError,
             "'?!' propagates error type '{0}' but function does not raise '{0}'", 1)
CHECKER_DIAG(461, ErrorUnwrapNonUnion, kError, "'!!' on non-error-union type '{0}'", 1)
