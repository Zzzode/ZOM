DIAG(4036, CallArgumentCountMismatch, kError, "Expected {0} arguments, got {1}", 2)
DIAG(4037, MemberNotFound, kError, "No member named {0} exists in type {1}", 2)
DIAG(4038, IndexRequiresInteger, kError, "Array index must be an integer, got {0}", 1)
