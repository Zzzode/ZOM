DIAG(4032, ErrorPropagateNonUnion, kError, "Error propagation requires an error union, got {0}", 1)
DIAG(4033, ErrorUnionEmpty, kError, "Postfix error operator requires a non-empty union operand", 0)
DIAG(4035, ExplicitTypeArgumentsRequireGenericCallee, kError,
