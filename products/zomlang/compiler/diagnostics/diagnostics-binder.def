// RFC 0004 binder diagnostics. Numeric values are explicit because the binder
// contract assigns stable ZOM30xx codes independent of file order.

DIAG(3001, UndefinedIdentifier, kError, "Undefined identifier: '{0}'", 1)
DIAG(3002, SymbolNamespaceMismatch, kError,
             "Symbol '{0}' cannot be used in {1} context", 2)
DIAG(3003, RedeclareVariable, kError, "Cannot redeclare variable '{0}'", 1)
DIAG(3004, RedeclareParameter, kError, "Cannot redeclare parameter '{0}'", 1)
DIAG(3005, RedeclareFunction, kError, "Cannot redeclare function '{0}'", 1)
DIAG(3006, RedeclareClass, kError, "Cannot redeclare class '{0}'", 1)
DIAG(3007, RedeclareInterface, kError, "Cannot redeclare interface '{0}'", 1)
DIAG(3008, RedeclareEnum, kError, "Cannot redeclare enum '{0}'", 1)
DIAG(3009, RedeclareTypeAlias, kError, "Cannot redeclare type alias '{0}'", 1)
DIAG(3010, DuplicateIdentifier, kError, "Duplicate identifier: '{0}'", 1)
DIAG(3017, PreviousDeclarationHere, kNote, "Previous declaration is here", 0)
DIAG(3020, BreakTargetNotFound, kError,
     "break requires an enclosing loop, match, or label", 0)
DIAG(3021, ContinueTargetNotFound, kError,
     "continue requires an enclosing loop or loop label", 0)
DIAG(3022, ContinueTargetNotLoop, kError, "continue label must name a loop", 0)
DIAG(9922, BinderMalformedScopeGraph, kFatal,
     "Internal binder scope graph is invalid ({0} occurrence(s))", 1)
DIAG(9923, BinderMissingRequiredResolution, kFatal,
     "Internal binder required resolution is missing ({0} occurrence(s))", 1)
DIAG(9924, BinderAliasCycle, kFatal,
     "Internal binder alias graph contains a cycle ({0} occurrence(s))", 1)
DIAG(9925, BinderInvalidFact, kFatal,
     "Internal binder fact is invalid ({0} occurrence(s))", 1)
DIAG(9926, BinderInvalidEmitterOrdinal, kFatal,
     "Internal binder diagnostic ordinal is invalid ({0} occurrence(s))", 1)
DIAG(9956, ModuleGraphInvariant, kFatal,
     "Internal module graph invariant violated ({0} occurrence(s))", 1)
