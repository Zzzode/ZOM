interface Sub {
    fn sub(rhs: Number) -> Number;
}

interface Mul {
    fn mul(rhs: Number) -> Number;
}

interface Div {
    fn div(rhs: Number) -> Number;
}

interface Rem {
    fn rem(rhs: Number) -> Number;
}

class Number { }

impl Sub for Number {
    fn sub(rhs: Number) -> Number;
}

impl Mul for Number {
    fn mul(rhs: Number) -> Number;
}

impl Div for Number {
    fn div(rhs: Number) -> Number;
}

impl Rem for Number {
    fn rem(rhs: Number) -> Number;
}

let x: Number;
let y: Number;
let difference: Number = x - y;
let product: Number = x * y;
let quotient: Number = x / y;
let remainder: Number = x % y;
