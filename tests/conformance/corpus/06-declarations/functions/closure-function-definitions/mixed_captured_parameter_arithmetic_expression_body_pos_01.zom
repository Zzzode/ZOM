// RFC 0057 slice 2 expr-body mixed positive: a one-parameter paren-arrow
// lambda with no block or return whose sole expression combines its declared
// by-value i32 parameter with one initialized read-only i32 local captured by
// value, reached through a whole-local copy chain. Admitted only behind the
// default-off --experimental-captures gate; without it this source keeps the
// ZOM4099 capability drain.
fn entry() -> i32 {
  let a: i32 = 40;
  let f = (n: i32) -> i32 => n + a;
  let g = f;
  return g(2);
}
