// RFC 0057 slice 2 nested positive: a non-capturing two-parameter
// expression-body lambda whose outer arithmetic binary has a one-level nested
// binary over both parameters as its left operand and an integer literal as
// its right operand, reached through a whole-local copy chain. The inner binary
// lowers to a body temporary; this needs no experimental capture gate because
// it captures nothing.
fn entry() -> i32 {
  let f = (a: i32, b: i32) -> i32 => (a + b) + 1;
  let g = f;
  return g(20, 21);
}
