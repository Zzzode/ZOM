// RFC 0057 slice 2 positive: a non-capturing two-parameter expression-body
// lambda whose parameter-plus-literal body names the parameter at ordinary
// position one (`b + 1`), with the first declared parameter unused. The
// parameter reference reconciles to the second published parameter key,
// reached through a whole-local copy chain; this needs no experimental
// capture gate because it captures nothing.
fn entry() -> i32 {
  let f = (a: i32, b: i32) -> i32 => b + 1;
  let g = f;
  return g(20, 21);
}
