// RFC 0057 slice 2 positive: a non-capturing two-parameter expression-body
// lambda whose unary body names the parameter at ordinary position one
// (`-b`), with the first declared parameter unused. The parameter reference
// reconciles to the second published parameter key, reached through a
// whole-local copy chain; the unary desugars to a
// parameter-plus-synthetic-constant binary and needs no capture gate.
fn entry() -> i32 {
  let f = (a: i32, b: i32) -> i32 => -b;
  let g = f;
  return g(20, 21);
}
