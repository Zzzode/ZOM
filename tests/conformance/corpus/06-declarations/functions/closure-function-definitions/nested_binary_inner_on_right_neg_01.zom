// RFC 0057 slice 2 nested negative: the one-level nested binary sits on the
// right of the outer arithmetic with the integer literal on the left. Only the
// mirrored inner-on-left shape has an admitted HIR stride and MIR/LIR slice, so
// the owning function keeps one ZOM4099 capability diagnostic with zero
// incidents rather than reaching an invariant failure.
fn entry() -> i32 {
  let f = (a: i32, b: i32) -> i32 => 1 + (a + b);
  let g = f;
  return g(20, 21);
}
