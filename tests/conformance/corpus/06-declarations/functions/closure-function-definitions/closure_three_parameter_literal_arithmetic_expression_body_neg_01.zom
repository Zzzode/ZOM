// RFC 0059 negative: three declared parameters are admitted only for the bare
// parameter-reference closure arm. A three-parameter parameter-plus-literal
// closure, even when the identifier names an inner parameter, keeps the
// owning function on one ZOM4099 capability diagnostic with zero incidents.
fn entry() -> i32 {
  let f = (a: i32, b: i32, c: i32) -> i32 => b + 1;
  let g = f;
  return g(20, 21, 22);
}
