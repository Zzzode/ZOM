// RFC 0057 slice 2 positive: a non-capturing one-parameter block-body
// function-expression closure whose sole return is one integer arithmetic
// binary over its declared parameter and one integer literal, invoked
// directly on the origin binding. This needs no experimental capture gate
// because it captures nothing. The program exits 3 (2 plus 1).
fn entry() -> i32 {
  let f = fn (n: i32) -> i32 { return n + 1; };
  return f(2);
}
