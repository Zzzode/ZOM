// RFC 0059 negative: three declared parameters are admitted only for the bare
// parameter-reference closure arm. A three-parameter arithmetic
// expression-body lambda keeps the owning function on one ZOM4099 capability
// diagnostic with zero incidents.
fn entry() -> i32 {
  let f = (a: i32, b: i32, c: i32) -> i32 => a + b + c;
  let g = f;
  return g(1, 2, 3);
}
