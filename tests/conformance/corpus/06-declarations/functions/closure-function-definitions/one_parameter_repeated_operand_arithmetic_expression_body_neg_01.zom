// RFC 0057 slice 2 negative: a one-parameter expression-body lambda whose
// binary names the sole declared parameter twice matches no admitted closure
// body (a parameter binary needs two distinct declared parameters; the
// parameter-plus-literal form needs one integer literal operand). The owning
// function keeps one ZOM4099 capability diagnostic with zero incidents.
fn entry() -> i32 {
  let f = (n: i32) -> i32 => n + n;
  let g = f;
  return g(41);
}
