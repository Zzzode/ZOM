// RFC 0057 slice 2 negative: an expression-body paren-arrow lambda yields an
// arithmetic binary over two captured locals. The expression-body capture
// slice admits only a single captured identifier directly; two-capture
// arithmetic stays on the block-body function-expression spelling, so even
// with --experimental-captures the owning function keeps one ZOM4099
// capability diagnostic with zero incidents.
fn entry() -> i32 {
  let a: i32 = 40;
  let b: i32 = 2;
  let f = () -> i32 => a + b;
  let g = f;
  return g();
}
