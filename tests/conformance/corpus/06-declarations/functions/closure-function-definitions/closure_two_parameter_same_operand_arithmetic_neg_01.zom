// RFC 0057 slice 2 negative: the two-parameter arithmetic closure must combine
// two distinct declared parameters. Repeating one parameter (`a + a`) does not
// name both, so the owning function keeps one ZOM4099 capability diagnostic
// with zero incidents.
fn entry() -> i32 {
  let f = (a: i32, b: i32) -> i32 => a + a;
  let g = f;
  return g(20, 2);
}
