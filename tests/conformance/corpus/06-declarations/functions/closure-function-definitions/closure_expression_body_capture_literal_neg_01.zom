// RFC 0057 slice 2 negative: an expression-body paren-arrow lambda yields an
// arithmetic binary over one captured local and an integer literal. Arithmetic
// capture bodies stay on the block-body function-expression spelling; the
// expression-body capture slice yields a captured identifier directly only, so
// even with --experimental-captures the owning function keeps one ZOM4099
// capability diagnostic with zero incidents.
fn entry() -> i32 {
  let a: i32 = 41;
  let f = () -> i32 => a + 1;
  let g = f;
  return g();
}
