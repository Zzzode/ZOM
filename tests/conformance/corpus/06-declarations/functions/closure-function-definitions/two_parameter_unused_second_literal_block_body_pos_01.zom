// RFC 0057 slice 2 positive: a non-capturing two-parameter block-body
// function-expression closure whose sole return is one integer arithmetic
// binary over the parameter at ordinary position zero and one integer
// literal. The second declared parameter is unused, reached through a
// whole-local copy chain. This needs no experimental capture gate because
// it captures nothing.
fn entry() -> i32 {
  let f = fn (a: i32, b: i32) -> i32 { return a + 1; };
  let g = f;
  return g(20, 21);
}
