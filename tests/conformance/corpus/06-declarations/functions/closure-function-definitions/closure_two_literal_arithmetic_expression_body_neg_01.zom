// RFC 0057 slice 2 negative: an expression-body paren-arrow lambda yielding an
// arithmetic binary over two integer literals names no parameter and captures
// nothing, so it matches no admitted expression-body closure form. With the
// gate on the owning function keeps one ZOM4099 capability diagnostic with
// zero incidents.
fn entry() -> i32 {
  let f = () -> i32 => 1 + 2;
  let g = f;
  return g();
}
