// RFC 0057 slice 2 positive: a non-capturing two-parameter block-body
// function-expression closure whose sole return is one integer unary
// operation over the position-zero parameter. The second declared parameter
// is unused, reached through a whole-local copy chain. The unary desugars to
// a parameter-plus-synthetic-constant binary; this needs no experimental
// capture gate because it captures nothing.
fn entry() -> i32 {
  let f = fn (a: i32, b: i32) -> i32 { return -a; };
  let g = f;
  return g(20, 21);
}
