// RFC 0057 slice 2 repeated-operand positive: a non-capturing two-parameter
// expression-body lambda whose arithmetic binary names the same declared
// parameter on both sides (`a + a`), reached through a whole-local copy chain.
// Both HIR parameter references carry one key and MIR reads that parameter
// local twice; no capture gate is needed because it captures nothing.
fn entry() -> i32 {
  let f = (a: i32, b: i32) -> i32 => a + a;
  let g = f;
  return g(20, 21);
}
