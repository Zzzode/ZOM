// RFC 0057 slice 2: a non-capturing one-parameter expression-body lambda
// whose sole expression is one integer unary negation over its declared
// parameter, reached through a whole-local copy chain. The unary desugars to a
// parameter-plus-synthetic-constant binary; this needs no experimental capture
// gate because it captures nothing.
fn entry() -> i32 {
  let f = (n: i32) -> i32 => -n;
  let g = f;
  return g(5);
}
