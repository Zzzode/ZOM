// RFC 0057 slice 2 positive: a non-capturing two-parameter block-body
// function-expression closure whose sole return is a unary over the parameter
// at ordinary position one (`return -b`), with the first declared parameter
// unused, reached through a whole-local copy chain. The parameter reference
// reconciles to the second published parameter key; this needs no capture gate.
fn entry() -> i32 {
  let f = fn (a: i32, b: i32) -> i32 { return -b; };
  let g = f;
  return g(20, 21);
}
