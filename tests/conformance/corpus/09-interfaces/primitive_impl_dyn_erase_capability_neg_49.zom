// A primitive has an impl of the interface, so the annotated dyn initializer
// satisfies its obligation: the checker selects the impl instead of reporting
// ZOM4018. The HIR erasure carrier for a primitive receiver is not built yet,
// so the body drains the capability code.

interface StrExt {
    fn len2(this) -> i32;
}

impl StrExt for str {
    fn len2(this) -> i32 {
        return 41;
    }
}

fn entry(s: str) -> i32 {
    let d: dyn StrExt = s;
    return 41;
}
