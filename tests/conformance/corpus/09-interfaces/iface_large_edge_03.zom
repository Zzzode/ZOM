interface LargeIface {
    type Item;
    type Iter;
    type Error : Error;
    fn size() -> u64;
    fn get(i: u64) -> Item;
    fn set(i: u64, v: Item) -> unit;
    fn contains(v: Item) -> bool;
    fn find(pred: (Item) -> bool) -> i64;
    fn map<U>(f: (Item) -> U) -> [U];
    fn filter(pred: (Item) -> bool) -> [Item];
    fn reduce<A>(acc: A, f: (A, Item) -> A) -> A;
    get isEmpty() -> bool;
    get length() -> u64;
    set length(v: u64) -> unit;
}
