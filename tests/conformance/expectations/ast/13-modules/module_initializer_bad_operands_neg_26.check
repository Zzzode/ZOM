// RUN: %zomc compile --dump-ast %corpus/13-modules/module_initializer_bad_operands_neg_26.zom | %FileCheck %s

// The AST shape of a module-scope binary initializer is well-formed; the type
// error (bool has no arithmetic) is a checker-stage refusal (ZOM4028).

// CHECK: SourceFile #9 @1:1..2:1 file_name="module_initializer_bad_operands_neg_26.zom"
// CHECK-NEXT:   module: null
// CHECK-NEXT:   statements:
// CHECK-NEXT:     StatementListItem #8 @1:1..1:26
// CHECK-NEXT:       item:
// CHECK-NEXT:         LetStmt #7 @1:1..1:26 kind=Let
// CHECK-NEXT:           declarations:
// CHECK-NEXT:             VariableDeclaratorList #6 @1:5..1:25 n_decls=1
// CHECK-NEXT:               decls:
// CHECK-NEXT:                 VariableDeclarator #5 @1:5..1:25
// CHECK-NEXT:                   pattern:
// CHECK-NEXT:                     IdentifierPattern #1 @1:5..1:10 name="total"
// CHECK-NEXT:                       ty: null
// CHECK-NEXT:                   ty: null
// CHECK-NEXT:                   init:
// CHECK-NEXT:                     BinaryExpr #4 @1:13..1:25 op=Add
// CHECK-NEXT:                       lhs:
// CHECK-NEXT:                         BoolLiteral #2 @1:13..1:17 value=true
// CHECK-NEXT:                       rhs:
// CHECK-NEXT:                         BoolLiteral #3 @1:20..1:25 value=false
// CHECK-NEXT:       attrs: null
