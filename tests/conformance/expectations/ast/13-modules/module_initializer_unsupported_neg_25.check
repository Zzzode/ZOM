// RUN: %zomc compile --dump-ast %corpus/13-modules/module_initializer_unsupported_neg_25.zom | %FileCheck %s

// The parser accepts module-scope initializers whose expression the checker
// has no semantic contract for; ZOM4104 is the checker-stage refusal. The AST
// shape itself is well-formed and must stay stable.

// CHECK: SourceFile #8 @1:1..2:1 file_name="module_initializer_unsupported_neg_25.zom"
// CHECK-NEXT:   module: null
// CHECK-NEXT:   statements:
// CHECK-NEXT:     StatementListItem #7 @1:1..1:24
// CHECK-NEXT:       item:
// CHECK-NEXT:         LetStmt #6 @1:1..1:24 kind=Let
// CHECK-NEXT:           declarations:
// CHECK-NEXT:             VariableDeclaratorList #5 @1:5..1:23 n_decls=1
// CHECK-NEXT:               decls:
// CHECK-NEXT:                 VariableDeclarator #4 @1:5..1:23
// CHECK-NEXT:                   pattern:
// CHECK-NEXT:                     IdentifierPattern #1 @1:5..1:10 name="total"
// CHECK-NEXT:                       ty: null
// CHECK-NEXT:                   ty: null
// CHECK-NEXT:                   init:
// CHECK-NEXT:                     TypeOfExpression #3 @1:13..1:23
// CHECK-NEXT:                       expr:
// CHECK-NEXT:                         IntLiteral #2 @1:20..1:23 base=10 value="123"
// CHECK-NEXT:       attrs: null
