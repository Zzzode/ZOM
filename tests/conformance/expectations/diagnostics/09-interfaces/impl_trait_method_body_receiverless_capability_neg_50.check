// RUN: cd %corpus && ! %zomc compile --check 09-interfaces/impl_trait_method_body_receiverless_capability_neg_50.zom > %t 2>&1
// RUN: %FileCheck %s --input-file %t

// A receiverless concrete trait method supplied by a standalone impl block is
// not in the lowered surface yet. The owning method drains once as ZOM4099 in
// the checker body analysis, before any production-site invariant, rather than
// an internal compiler error.

