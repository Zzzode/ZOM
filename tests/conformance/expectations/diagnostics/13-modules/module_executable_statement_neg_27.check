// RUN: cd %corpus && ! %zomc compile --check 13-modules/module_executable_statement_neg_27.zom > %t 2>&1
// RUN: %FileCheck %s --input-file %t

// Module scope admits declarations, not bare executable statements such as a
// reassignment; the checker refuses with ZOM4105 rather than raising an
// internal compiler error.
// CHECK-LITERAL: Error [ZOM4105]: Module scope only admits declarations; executable statements have no admitted semantic contract
// CHECK-LITERAL:   --> conformance/13-modules/module_executable_statement_neg_27.zom:2:1
