// RUN: cd %corpus && ! %zomc compile --check 05-statements/conditional_local_then_local_capability_neg.zom > %t 2>&1
// RUN: %FileCheck %s --input-file %t

// A two-local body whose leading binding is initialized by a ternary has no
// MIR initializer form on the legacy sequential rail. It used to reach
// rejectMir(MissingRequiredFact) at phase ir -- an internal compiler error.
// The rail now treats "this initializer is neither a scalar expression nor a
// call" as the capability boundary it is, so the body drains at its function
// span instead.

// CHECK-LITERAL: Error [ZOM4099]: this function body uses a construct the compiler cannot generate code for yet
// CHECK-LITERAL:   --> conformance/05-statements/conditional_local_then_local_capability_neg.zom:1:26
