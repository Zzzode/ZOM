// RUN: cd %corpus && ! %zomc compile --check 08-adt/inherent_method_unannotated_binary_local_neg_20.zom > %t 2>&1
// RUN: %FileCheck %s --input-file %t

// A receiver method body that initializes a local from a binary expression is
// outside the lowered method-body slice (which admits receiver-field reads),
// regardless of whether the binding is annotated. The checker drains the whole
// definition as ZOM4099, never as an internal compiler error.

// CHECK-LITERAL: Error [ZOM4099]: this function body uses a construct the compiler cannot generate code for yet
// CHECK: 3 |   fun m(this, x: i32) -> i32 { let z = x + 1; return z; }
