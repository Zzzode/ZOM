// RUN: cd %corpus && ! %zomc compile --check 08-adt/mutating_modifier_constructor_neg_01.zom > %t 2>&1
// RUN: %FileCheck %s --input-file %t

// A constructor is not a method, so `mutating init` is rejected on the
// modifier instead of being silently dropped.

