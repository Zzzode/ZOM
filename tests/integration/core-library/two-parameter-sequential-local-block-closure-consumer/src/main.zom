// RFC 0057 slice 2 sequential-local nested: a non-capturing two-parameter
// block-body function-expression closure whose leading let binding computes an
// arithmetic binary over both parameters and whose trailing return combines
// that local with an integer literal. It is reached through a whole-local copy
// chain and the indirect call passes two literal arguments. The binding lowers
// to a body temporary, and the program exits 42 for (20 + 21) + 1 through the
// indirect-call ABI.
fn entry() -> i32 {
  let f = fn(a: i32, b: i32) -> i32 { let t = a + b; return t + 1; };
  let g = f;
  return g(20, 21);
}
