// RFC 0057 slice 2 nested mirror: a non-capturing two-parameter
// expression-body lambda whose nested binary over both parameters is the outer
// right operand with the integer literal on the left. It is reached through a
// whole-local copy chain; the program exits 42 for 1 + (20 + 21) through the
// indirect-call ABI, proving the MIR/LIR lowering is operand-order independent.
fn entry() -> i32 {
  let f = (a: i32, b: i32) -> i32 => 1 + (a + b);
  let g = f;
  return g(20, 21);
}
