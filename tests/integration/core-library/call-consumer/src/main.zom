// KR5.2 C4 backend-lowering fixture: a two-function module -- a constant-return
// callee and a parameter-free caller that binds the call result and returns it
// -- that lowers MIR -> LIR -> a verified two-function LLVM module. The
// parameter-free caller folds to the reserved no-argument `zom.module_init`
// entry the runtime `_start` calls, so `zomc run` executes it natively.
fun callee() -> i32 { return 42; }
fun caller() -> i32 { let x = callee(); return x; }
