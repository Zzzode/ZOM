// Multi-call devirtualization fixture: a dyn-trait local whose concrete
// type is statically known at the erasure site. The first method call
// `a.speak()` is a discarded statement-position call; the second
// `a.speak()` is the trailing return. Both resolve to the direct impl
// method `Dog::speak` and the second returns 41.
interface Animal {
  fun speak(this) -> i32;
}

struct Dog {
  tag: i32,
}

impl Animal for Dog {
  fun speak(this) -> i32 { return 41; }
}

fun entry() -> i32 {
  let a: dyn Animal = Dog { tag: 0 };
  a.speak();
  return a.speak();
}
