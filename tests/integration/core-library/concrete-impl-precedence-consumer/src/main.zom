// Struct-member precedence fixture: `Pt` declares `d` in its own body and also
// receives `d` from `impl Draw for Pt`. A dot call searches the type's own
// members first, so `p.d()` selects the struct method and returns 7, not the
// impl method's 41.
struct Pt {
  x: i32,
  fn d(this) -> i32 { return 7; }
}

interface Draw {
  fn d(this) -> i32;
}

impl Draw for Pt {
  fn d(this) -> i32 { return 41; }
}

fn entry() -> i32 {
  let p = Pt { x: 1 };
  return p.d();
}
