// Four independently-lowerable scalar-return functions. The object selector
// lowers each through the standalone single-function ladder and combines them
// into one LIR module, renaming all but the first reserved zom.module_init
// symbol so the structural verifier's unique-symbol invariant holds.
fn first() -> i32 { return 42; }
fn second() -> i32 { return 9; }
fn third() -> i32 { return 5; }
fn fourth() -> i32 { return 7; }
