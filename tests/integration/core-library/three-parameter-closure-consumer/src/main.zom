// RFC 0059: a non-capturing closure with three ordinary i32 value parameters
// whose sole body value is its third parameter, reached through a whole-local
// copy chain and an indirect code-pointer value call. The caller passes three
// constants explicitly; the program exits 3 natively.
fn entry() -> i32 {
  let f = (a: i32, b: i32, c: i32) -> i32 => c;
  let g = f;
  return g(1, 2, 3);
}
