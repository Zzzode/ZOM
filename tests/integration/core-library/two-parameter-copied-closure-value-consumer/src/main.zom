// RFC 0057 slice 1b: a non-capturing closure value reached through a
// whole-local copy chain with two arguments. The origin local holds the
// closure address, the copy local holds the same pointer, and the trailing
// call invokes the closure through the final slot with two explicit i32
// arguments. The program exits 40 natively through the indirect-call ABI.
fn entry() -> i32 {
  let f = fn(a: i32, b: i32) -> i32 {
    return a;
  };
  let g = f;
  return g(40, 2);
}
