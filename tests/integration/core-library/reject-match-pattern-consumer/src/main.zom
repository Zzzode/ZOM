// Fail-closed fixture: a non-literal binary expression in a match arm pattern
// (`1 | 2`) is not a supported pattern shape. The parser rejects it with
// ZOM2025 instead of creating a null pattern that crashes the driver.
fn entry(x: i32) -> i32 {
    match (x) {
        when 1 | 2 => return 41;
        default => return 7;
    }
}
