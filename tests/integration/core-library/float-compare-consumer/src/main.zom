// Float comparison conditional fixture: one f32 owner local initialized from
// a float literal guards a less-than comparison whose operands read that local
// and a float literal. Both arms return a scalar literal, and the true value
// of 1.5 < 2.5 selects the arm that exits 41. The float local is live (read
// by the if-condition), so the dead-erase filter preserves it through the
// full pipeline.
fn entry() -> i32 {
  let a: f32 = 1.5;
  if (a < 2.5) {
    return 41;
  } else {
    return 7;
  }
}
