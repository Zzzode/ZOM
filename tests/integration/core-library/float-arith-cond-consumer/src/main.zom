// Float arithmetic in conditional fixture: two f32 owner locals initialized
// from float literals feed a one-level nested arithmetic operand of a
// less-than comparison. The HIR builder synthesizes a leading local binding
// for the arithmetic result, then compares that local against a float
// literal. Both arms return a scalar literal, and the true value of
// 1.5 + 2.5 < 10.0 selects the arm that exits 41.
fun entry() -> i32 {
  let a: f32 = 1.5;
  let b: f32 = 2.5;
  if (a + b < 10.0) {
    return 41;
  } else {
    return 7;
  }
}
