// Multi-argument backend-lowering fixture: a two-function module -- a callee
// that returns its first of two integer parameters and a parameter-free caller
// that invokes it with two constant arguments and returns the result -- that
// lowers MIR -> LIR -> a verified two-function LLVM module. The parameter-free
// caller folds to the reserved no-argument `zom.module_init` entry the runtime
// `_start` calls, so `zomc run` executes it natively.
fun callee(a: i32, b: i32) -> i32 { return a; }
fun caller() -> i32 { let y = callee(3, 4); return y; }
