// Multi-argument backend-lowering fixture: a two-function module -- a callee
// that returns its first of two integer parameters and a caller that invokes it
// with two constant arguments and returns the result -- that lowers
// MIR -> LIR -> a verified two-function LLVM relocatable object. Both functions
// keep parameterized `zom.caller` / `zom.callee` symbols, so the module is
// object-emittable but not runnable through the reserved `zom.module_init`
// entry -- `zomc run` stays fail-closed on it until a later slice.
fun callee(a: i32, b: i32) -> i32 { return a; }
fun caller() -> i32 { let y = callee(3, 4); return y; }
