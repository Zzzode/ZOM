// Three-function backend-lowering fixture (S-call): a same-module direct-call
// caller, its constant-return callee, and one standalone leaf that no call
// references. The module lowers MIR -> LIR -> a verified three-function LLVM
// module emitted in the fixed order [caller, callee, leaf]. The parameter-free
// caller folds to the reserved no-argument `zom.module_init` entry the runtime
// `_start` calls, so `zomc run` executes it natively.
fn callee() -> i32 { return 42; }
fn leaf() -> i32 { return 9; }
fn caller() -> i32 { let x = callee(); return x; }
