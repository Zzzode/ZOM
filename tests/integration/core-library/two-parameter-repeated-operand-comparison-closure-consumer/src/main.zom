// RFC 0057 slice 2 repeated-operand relational: a non-capturing two-parameter
// lambda whose comparison names the same parameter twice. It is reached through
// a whole-local copy chain and exits 0 because a < a is always false.
fn entry() -> bool {
  let f = (a: i32, b: i32) -> bool => a < a;
  let g = f;
  return g(20, 2);
}
