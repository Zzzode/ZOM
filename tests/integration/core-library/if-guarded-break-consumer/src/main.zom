// If-guarded break fixture: a for-loop accumulator whose body leads with an
// if-guarded break, exercising the five-block loop CFG (entry/header/guard/
// continuation/exit) through the full IR pipeline. The break fires when
// i == 5, so the sum is 0+1+2+3+4 = 10.
fn entry() -> i32 {
  mut sum = 0;
  for (let i = 0; i < 10; i = i + 1) {
    if (i == 5) { break; }
    sum = sum + i;
  }
  return sum;
}
