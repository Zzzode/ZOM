// A non-capturing two-parameter block-body function-expression closure whose
// sole return is a parameter-plus-literal binary naming the position-one
// parameter; the first declared parameter is unused. Reached through a
// whole-local copy chain; the indirect call still passes two source literal
// arguments. The program exits 22 (21 plus 1).
fn entry() -> i32 {
  let f = fn (a: i32, b: i32) -> i32 { return b + 1; };
  let g = f;
  return g(20, 21);
}
