// RFC 0057 slice 2 repeated-operand: a non-capturing two-parameter
// expression-body lambda whose arithmetic binary names the same declared
// parameter on both sides. It is reached through a whole-local copy chain; the
// program exits 40 for 20 + 20 because both operands read the first argument.
fn entry() -> i32 {
  let f = (a: i32, b: i32) -> i32 => a + a;
  let g = f;
  return g(20, 21);
}
