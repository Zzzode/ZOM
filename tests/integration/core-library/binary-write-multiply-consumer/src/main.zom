// Binary-write multiply fixture: a parameter-free entry that initializes a
// mutable local, overwrites it with a multiplication whose both operands read
// the same local (`x = x * x`), and returns the result. Exercises the Mul
// operation and the both-operands-local case in the binary-write local path.
// Exits 9.
fn entry() -> i32 {
  mut x = 3;
  x = x * x;
  return x;
}
