// Match-guard backend-lowering fixture: a two-arm boolean match with a guard
// condition on the literal arm. The guard (`x > 0`) is evaluated as a
// conjunctive condition (scrutinee AND guard) keeping the four-block diamond
// CFG. The parameter-free entry calls the match function with constant
// arguments and folds to the reserved no-argument i32 `zom.module_init` entry
// the runtime `_start` calls, so `zomc run` executes it natively.
fn matchGuard(b: bool, x: i32) -> i32 {
    match (b) {
        when true if (x > 0) => return 41;
        default => return 7;
    }
}
fn entry() -> i32 { let r = matchGuard(true, 1); return r; }
