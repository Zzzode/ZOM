// Primitive unary plus fixture: a parameter-free entry that binds an integer
// local and returns its unary plus (`+x`). The HIR builder desugars the unary
// to an addition with a synthetic zero literal, so `zomc run` executes it
// natively and exits 41.
fn entry() -> i32 {
  let x: i32 = 41;
  return +x;
}
