// KR5.2 C5 backend-lowering fixture: a two-function module -- a callee that
// returns its single integer parameter and a caller that invokes it with a
// constant argument and returns the result -- that lowers MIR -> LIR -> a
// verified two-function LLVM relocatable object. Both functions keep parameterized
// `zom.caller` / `zom.callee` symbols, so the module is object-emittable but not
// runnable through the reserved `zom.module_init` entry -- `zomc run` stays
// fail-closed on it until a later slice.
fun callee(x: i32) -> i32 { return x; }
fun caller() -> i32 { let y = callee(7); return y; }
