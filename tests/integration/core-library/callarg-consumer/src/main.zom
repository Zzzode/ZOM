// KR5.2 C5 backend-lowering fixture: a two-function module -- a callee that
// returns its single integer parameter and a parameter-free caller that invokes
// it with a constant argument and returns the result -- that lowers MIR -> LIR
// -> a verified two-function LLVM module. The parameter-free caller folds to
// the reserved no-argument `zom.module_init` entry the runtime `_start` calls,
// so `zomc run` executes it natively.
fn callee(x: i32) -> i32 { return x; }
fn caller() -> i32 { let y = callee(7); return y; }
