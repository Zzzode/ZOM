// Match-on-integer backend-lowering fixture: a two-arm integer match with one
// literal pattern arm and one `default` arm on an i32 parameter that lowers
// through the equality conditional return path to a verified LLVM relocatable
// object. The default arm covers the open integer domain. The parameter-free
// entry calls the match function with a constant i32 argument and folds to
// the reserved no-argument i32 `zom.module_init` entry the runtime `_start`
// calls, so `zomc run` executes it natively.
fn matchInt(x: i32) -> i32 {
    match (x) {
        when 1 => return 41;
        default => return 7;
    }
}
fn entry() -> i32 { let v = matchInt(1); return v; }
