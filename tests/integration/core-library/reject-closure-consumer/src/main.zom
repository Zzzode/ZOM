// Fail-closed fixture: a one-parameter closure whose arithmetic binary names
// the sole declared parameter twice matches no admitted closure body (a
// parameter binary needs two distinct declared parameters; the
// parameter-plus-literal form needs one literal operand). Object emission
// rejects the owning function with ZOM4099 instead of publishing an object.
fn entry() -> i32 {
    let f = (x: i32) -> i32 => x + x;
    let g = f;
    return g(41);
}
