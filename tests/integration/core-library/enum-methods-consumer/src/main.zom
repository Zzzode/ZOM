// Enum method fixture: a trait impl on an enum type whose method is called
// through a devirtualized dyn-trait local. The erased local `c` is initialized
// with the enum unit variant Color::Red; the devirtualized call `c.isRed()`
// resolves to the direct impl method `Color::isRed` and returns 41.
interface RedCheck {
  fn isRed(this) -> i32;
}

enum Color {
  Red,
  Green,
  Blue,
}

impl RedCheck for Color {
  fn isRed(this) -> i32 { return 41; }
}

fn entry() -> i32 {
  let c: dyn RedCheck = Color::Red;
  return c.isRed();
}
