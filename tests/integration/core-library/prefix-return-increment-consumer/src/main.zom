// Prefix increment in return position: a parameter-free entry that initializes
// a mutable local, prefix-increments it (`++x`) in the return statement, and
// returns the result. The desugared binary write (`x = x + 1`) followed by a
// local reference return folds to the reserved no-argument `zom.module_init`
// entry the runtime `_start` calls, so `zomc run` executes it natively and
// exits 42.
fn entry() -> i32 {
  mut x = 41;
  return ++x;
}
