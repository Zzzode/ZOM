// KR5.2 C2 backend-lowering fixture: a single reducible while-loop `Function`
// (no module initializer) that lowers MIR -> LIR -> a verified LLVM relocatable
// object. It keeps the `zom.loop` parameterized symbol, so it is object-emittable
// but not runnable through the reserved `zom.module_init` entry -- `zomc run`
// stays fail-closed on it until a later slice.
fun entry(cond: bool) -> i32 { while (cond) { } return 5; }
