// KR5.2 C2 backend-lowering fixture: a single reducible while-loop `Function`
// (no module initializer) that lowers MIR -> LIR -> a verified LLVM relocatable
// object. The loop body carries a scalar-local write, so the loop lowers to a
// reducible four-block CFG. It keeps the `zom.loop` parameterized symbol, so
// it is object-emittable but not runnable through the reserved
// `zom.module_init` entry -- `zomc run` stays fail-closed on it until a later
// slice.
fn entry(cond: bool) -> i32 { mut x = 0; while (cond) { x = x + 1; } return x; }
