// Mutating-receiver method called on a mutable owner local: the call activates
// the receiver as a mutable borrow, lowers through the receiver-borrow call
// shape, and returns 7 from the module initializer.
struct Cell {
  value: i32,
  mutating fun bump(this) -> i32 { return 7; }
}
fun entry() -> i32 { mut cell = Cell { value: 42 }; return cell.bump(); }
