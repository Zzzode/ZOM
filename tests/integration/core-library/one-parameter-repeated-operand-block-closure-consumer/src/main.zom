// RFC 0057 slice 2 one-parameter repeated-operand (block spelling): a
// non-capturing one-parameter block-body function-expression closure whose
// binary names its sole parameter twice. It is reached through a whole-local
// copy chain and exits 82 for 41 + 41 through the indirect-call ABI.
fn entry() -> i32 {
  let f = fn (n: i32) -> i32 { return n + n; };
  let g = f;
  return g(41);
}
